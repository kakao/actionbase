---
import logoLight from '../assets/logo-light.svg?url';
import logoDark from '../assets/logo-dark.svg?url';
import { Check, Copy, RotateCcw } from '@lucide/astro';

// Standalone marketing landing. Kept outside Starlight's content collection so
// the bespoke chrome (marginalia, hero console, architecture flow) has full
// layout control; theme state still syncs with Starlight via the shared
// `starlight-theme` localStorage key and `<html data-theme>` attribute.

const GA_ID = 'G-2PY5JXRJ5J';
const site = 'https://actionbase.io/';
const pageTitle = 'Actionbase — A database for user interactions at scale';
const description =
  'Actionbase serves follows, likes, and views as precomputed lookups — one model for ' +
  'user–user, user–item, and item–item interactions, in production at Kakao at over a ' +
  'million requests per minute.';
const ogUrl = new URL('og.png?v=1', site).href;
const ogImageAlt =
  'Actionbase is a production-proven OLTP database serving tens of millions of users across Kakao.';
const repo = 'https://github.com/kakao/actionbase';

// ASCII otter banner, coloured to mirror the real CLI welcome art (ANSI 33):
// the otter body stays the default terminal foreground; the frame, the heart,
// the right-hand info labels and the "Actionbase" wordmark are gold. Each line
// is a list of [text, gold?] segments — concatenated they reproduce the raw
// art, and gold runs are wrapped in a <span class="g"> at build time.
const BANNER_WIDTH = 98;
const G = true;
const bannerSegs = [
  [['', false]],
  [['                    _____________', false]],
  [['                 __/      ___    \\        Welcome to Actionbase! v0.2.1', false]],
  [['               _/\\   ____/   \\____\\_', false]],
  [['              / \\/ _/      @    \\_', false], ['♥/', G], ['\\     ', false], ['Actionbase  standalone:8080', G]],
  [['             /   /                | |', false]],
  [['           _/   /             ___/ \\/     ', false], ['proxy', G], ['  off', false]],
  [['          /     |           ______/       ', false], ['debug', G], ['  off', false]],
  [['       __/      |          /', false]],
  [['   ___/         \\        _/', false]],
  [['                 |      /\\__', false]],
  [['                 |     /    \\__', false], ['          _        _   _             _', G]],
  [['                 |    /______  \\', false], ['        / \\   ___| |_(_) ___  _ __ | |__   __ _ ___  ___', G]],
  [["              \\   \\_         \\  \\", false], ["      / _ \\ / __| __| |/ _ \\| '_ \\| '_ \\ / _` / __|/ _ \\", G]],
  [["               \\__  \\__       |_|", false], ["     / ___ \\ (__| |_| | (_) | | | | |_) | (_| \\__ \\  __/", G]],
  [['                  \\____\\', false], ['              /_/   \\_\\___|\\__|_|\\___/|_| |_|_.__/ \\__,_|___/\\___|', G]],
  [['', false]],
];
const escHtml = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const goldSpan = (s) => `<span class="g">${escHtml(s)}</span>`;
const bannerLine = (segs) => {
  const raw = segs.map(([t]) => t).join('');
  const pad = ' '.repeat(Math.max(0, BANNER_WIDTH - raw.length));
  const inner = segs.map(([t, g]) => (g ? goldSpan(t) : escHtml(t))).join('') + pad;
  return goldSpan('│') + inner + goldSpan('│');
};
const banner = [
  goldSpan('╭' + '─'.repeat(BANNER_WIDTH) + '╮'),
  ...bannerSegs.map(bannerLine),
  goldSpan('╰' + '─'.repeat(BANNER_WIDTH) + '╯'),
].join('\n');

const primaryFeatures = [
  { title: 'Pre-computed Reads', desc: 'Writes do the work. Reads return what’s already computed.' },
  { title: 'U2U · U2I · I2I', desc: 'One model for user–user, user–item, and item–item interactions.' },
  { title: 'Battle-tested', desc: 'Over a million requests per minute in stable production at Kakao.' },
];

const platformFeatures = [
  { title: 'REST API', desc: 'Simple writes, fast reads — all via HTTP.' },
  { title: 'CDC Built-in', desc: 'Stream changes for downstream pipelines.' },
  { title: 'Pluggable Storage', desc: 'A minimal storage abstraction — HBase today, SlateDB planned.' },
];

// Both paths converge on one wide Storage Backend. Kafka sits on the write side
// only (WAL in, CDC out); the read path (Query doc) is a direct lookup.
const writeNode = { name: 'Kafka', sub: 'WAL in · CDC out' };
const readNode = { name: 'GET · COUNT · SCAN', sub: 'direct REST lookups' };
const storageNode = { name: 'Storage Backend', sub: 'state · index · count — HBase / SlateDB' };

const steps = [
  { n: '1', label: 'Run', code: 'docker run -it \\\n  ghcr.io/kakao/actionbase:standalone' },
  { n: '2', label: 'Load sample data', code: 'load preset likes' },
  {
    n: '3',
    label: 'Query — just read',
    code: 'get   --source Alice --target Phone\nscan  --index recent --start Bob --direction OUT\ncount --start Phone --direction IN',
  },
];

const presets = [
  { cmd: 'get --source Alice --target Phone', desc: 'Fetch a single edge' },
  { cmd: 'scan --index recent --start Bob --direction OUT', desc: 'List edges, newest first' },
  { cmd: 'count --start Phone --direction IN', desc: 'Count edges on a node' },
];

// Teaser for query operations that exist internally but aren't shipped yet —
// shown disabled ("TBD") to hint at what's coming. topk covers issue #369
// shapes 2 (Target|Window) and 4 (Target|Filter,Window).
const soon = [
  { cmd: 'agg --start Phone --direction IN --by hour --last 1d', desc: 'Aggregate edges over time' },
  { cmd: 'topk --target product --edge purchase --last 1w', desc: 'Trending items this week' },
  { cmd: 'topk --start Bob --target product --edge purchase --last 1y', desc: "A user's recent purchases" },
  { cmd: 'multihop --start Alice --path follow,wish', desc: "Friends' wishes, across hops" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" class="js-site-favicon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Actionbase" />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Apply persisted theme before paint to avoid a flash; shares Starlight's key. -->
    <script is:inline>
      (function () {
        const stored = typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <script is:inline>
      (function () {
        const updateFavicon = () => {
          const isDark = document.documentElement.dataset.theme === 'dark';
          const favicon = document.querySelector('.js-site-favicon');
          if (favicon) favicon.href = isDark ? '/favicon-dark.svg' : '/favicon.svg';
        };
        updateFavicon();
        window.addEventListener('theme-change', updateFavicon);
      })();
    </script>

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>
  </head>

  <body>
    <div class="page">
      <a class="skip-link" href="#main">Skip to content</a>
      <!-- nav -->
      <nav class="nav">
        <a class="brand" href="/">
          <img class="brand-logo brand-logo-light" src={logoLight} alt="Actionbase" width="171" height="26" />
          <img class="brand-logo brand-logo-dark" src={logoDark} alt="Actionbase" width="171" height="26" />
        </a>
        <div class="nav-links">
          <a class="nav-text-link" href="/introduction/">Docs</a>
          <a class="nav-text-link nav-stories" href="/stories/">Stories</a>
          <a href={repo} class="gh-link" aria-label="GitHub">
            <svg class="gh-icon" viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
            </svg>
          </a>
          <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle color theme">
            <span data-theme-icon>☾</span>
          </button>
        </div>
      </nav>

      <main id="main">
      <!-- hero -->
      <header class="hero">
        <div class="hero-copy">
          <h1 class="title">
            Precomputed at write time, served as <span class="accent">simple lookups</span>
          </h1>
          <p class="lede">
            One database for user–user (follows), user–item (likes), and item–item (related
            items) interactions.
          </p>
          <div class="cta-row">
            <a class="btn btn-primary" href="/quick-start/">Quick Start</a>
            <a class="btn btn-outline" href="/introduction/">Explore docs</a>
          </div>
        </div>
      </header>

      <!-- trust band -->
      <section class="band">
        <div class="band-inner">
          <p class="band-statement">
            Serving over <span class="accent">a million requests per minute</span>, in production at Kakao.
          </p>
          <div class="tags">
            <span class="tag">#real-time</span>
            <span class="tag">#low-latency</span>
            <span class="tag">#high-throughput</span>
          </div>
        </div>
      </section>

      <!-- try it: live console + edge graph -->
      <section class="demo">
        <div class="demo-head">
          <h2>Interactive demo</h2>
          <button type="button" class="demo-reset" data-reset>
            <RotateCcw size={15} aria-hidden="true" />
            <span>Reset</span>
          </button>
        </div>
        <div class="demo-panels">
          <figure class="console term-fill">
            <div data-console>
              <div class="term">
                <div class="term-bar">
                  <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                  <span class="term-title">actionbase cli</span>
                </div>
                <div class="term-body">
                  <pre class="banner" set:html={banner}></pre>
                  <div data-lines role="log" aria-live="polite">
                    <div class="line"><span class="l l-sys">actionbase standalone · server :8080 · CLI ready</span></div>
                    <div class="line"><span class="l l-sys">preset 'likes' loaded — 3 edges</span></div>
                    <div class="line"><span class="l l-sys">Alice → Phone    Bob → Laptop    Bob → Phone</span></div>
                    <div class="line"><span class="l l-dim">click a command below to run it ↓</span></div>
                  </div>
                  <div class="input-row">
                    <span class="prompt">actionbase(likes:likes)&gt;</span>
                    <span class="term-cursor" aria-hidden="true"></span>
                    <span class="term-hint">click a command below ↓</span>
                  </div>
                </div>
              </div>
            </div>
          </figure>

          <figure class="graph panel">
            <figcaption class="graph-cap">Graph</figcaption>
            <svg class="graph-svg" viewBox="0 0 340 250" role="img" aria-label="Edge state graph" data-graph>
              <g class="gedge" data-edge="alice-phone" data-src="alice" data-dst="phone">
                <line x1="118" y1="72" x2="222" y2="66" />
                <text class="gedge-label" x="168" y="61">likes</text>
              </g>
              <g class="gedge" data-edge="bob-phone" data-src="bob" data-dst="phone">
                <line x1="118" y1="176" x2="222" y2="72" />
                <text class="gedge-label" x="150" y="120">likes</text>
              </g>
              <g class="gedge" data-edge="bob-laptop" data-src="bob" data-dst="laptop">
                <line x1="118" y1="180" x2="222" y2="184" />
                <text class="gedge-label" x="168" y="176">likes</text>
              </g>
              <g class="gnode gnode-user" data-node="alice">
                <rect x="24" y="52" width="94" height="40" rx="9" />
                <text class="gn-name" x="71" y="70">Alice</text>
                <text class="gn-type" x="71" y="83">user</text>
              </g>
              <g class="gnode gnode-user" data-node="bob">
                <rect x="24" y="156" width="94" height="40" rx="9" />
                <text class="gn-name" x="71" y="174">Bob</text>
                <text class="gn-type" x="71" y="187">user</text>
              </g>
              <g class="gnode gnode-item" data-node="phone">
                <rect x="222" y="46" width="94" height="40" rx="9" />
                <text class="gn-name" x="269" y="64">Phone</text>
                <text class="gn-type" x="269" y="77">item</text>
              </g>
              <g class="gnode gnode-item" data-node="laptop">
                <rect x="222" y="164" width="94" height="40" rx="9" />
                <text class="gn-name" x="269" y="182">Laptop</text>
                <text class="gn-type" x="269" y="195">item</text>
              </g>
            </svg>
          </figure>
        </div>

        <div class="demo-controls">
          <!-- Toggle buttons, not ARIA tabs: the full tabs pattern needs
               tabpanel wiring + arrow-key navigation, which two buttons
               don't earn. aria-pressed conveys the state instead. -->
          <div class="tabs" data-tabs>
            <button type="button" class="tab active" data-tab="supported" aria-pressed="true">
              Supported
            </button>
            <button type="button" class="tab" data-tab="soon" aria-pressed="false">
              Coming soon
            </button>
          </div>
          <div class="tab-panel" data-panel="supported">
            <div class="presets">
              {presets.map((p, i) => (
                <button type="button" class="preset" data-step={i} data-cmd={p.cmd}>
                  <span class="preset-cmd">{p.cmd}</span>
                  <span class="preset-desc">{p.desc}</span>
                </button>
              ))}
            </div>
          </div>
          <div class="tab-panel" data-panel="soon" hidden>
            <span class="soon-heading">Coming soon</span>
            <div class="presets">
              {soon.map((p) => (
                <button type="button" class="preset preset-soon" disabled>
                  <span class="preset-cmd">{p.cmd}</span>
                  <span class="preset-desc">{p.desc}</span>
                  <span class="tbd">TBD</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- features -->
      <section class="section feature-section">
        <div class="section-head">
          <h2>Why Actionbase</h2>
          <span class="kicker">Built for interaction data</span>
        </div>
        <div class="feature-group">
          <span class="feature-group-label">Core advantages</span>
          <div class="features features-primary">
            {
              primaryFeatures.map((f, i) => (
                <article class="card card-primary">
                  <span class="card-num">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{f.title}</h3>
                  <p>{f.desc}</p>
                </article>
              ))
            }
          </div>
        </div>
        <div class="feature-group">
          <span class="feature-group-label">Platform capabilities</span>
          <div class="features features-secondary">
            {
              platformFeatures.map((f, i) => (
                <article class="card card-secondary">
                  <span class="card-num">{String(i + 4).padStart(2, '0')}</span>
                  <h3>{f.title}</h3>
                  <p>{f.desc}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- architecture -->
      <section class="section arch">
        <div class="section-head">
          <h2>Architecture</h2>
          <span class="kicker">Client → Actionbase → storage &amp; stream</span>
        </div>
        <div class="arch-panel">
          <svg
            class="arch-svg"
            viewBox="0 0 620 448"
            role="img"
            aria-label="Client to Actionbase; write path through Kafka and read path through GET/COUNT/SCAN converge on one storage backend, which streams back out through Kafka."
          >
            <!-- connectors (broken around labels so lines never cross text) -->
            <path
              class="arch-line"
              d="M310 52 V80 M310 124 V152 M155 152 H465 M155 152 V180 M465 152 V196 M465 228 V286 M155 226 V286 M155 334 V390"
            />
            <!-- flow labels -->
            <text class="arch-lbl arch-lbl-rest" x="328" y="69">REST · HTTP</text>
            <text class="arch-lbl" x="155" y="145">WRITE PATH</text>
            <text class="arch-lbl" x="465" y="145">READ PATH</text>
            <!-- read requests: an operation on the path, not a component -->
            <text class="arch-req" x="465" y="207">GET · COUNT · SCAN</text>
            <text class="arch-sub" x="465" y="220">direct read</text>
            <!-- nodes -->
            <rect class="arch-box" x="255" y="12" width="110" height="40" rx="6" />
            <text class="arch-t" x="310" y="37">Client</text>

            <rect class="arch-box arch-box-accent" x="240" y="80" width="140" height="44" rx="6" />
            <text class="arch-t arch-t-accent" x="310" y="107">Actionbase</text>

            <rect class="arch-box" x="88" y="180" width="134" height="46" rx="6" />
            <text class="arch-t" x="155" y="201">Kafka</text>
            <text class="arch-sub" x="155" y="216">write WAL</text>

            <rect class="arch-box" x="85" y="286" width="450" height="48" rx="6" />
            <text class="arch-t" x="310" y="307">{storageNode.name}</text>
            <text class="arch-sub" x="310" y="322">{storageNode.sub}</text>

            <rect class="arch-box" x="88" y="390" width="134" height="44" rx="6" />
            <text class="arch-t" x="155" y="411">Kafka</text>
            <text class="arch-sub" x="155" y="426">write CDC</text>
          </svg>
        </div>
      </section>

      <!-- quick start -->
      <section class="quickstart">
        <div class="quickstart-inner">
          <div class="section-head">
            <h2>Quick start</h2>
            <span class="kicker">Three steps</span>
          </div>
          <div class="steps">
            {
              steps.map((s) => (
                <div class="step">
                  <div class="step-head">
                    <span class="step-num">{s.n}</span>
                    <span class="step-label">{s.label}</span>
                    <button
                      type="button"
                      class="copy-code"
                      data-copy-code={s.code}
                      aria-label={`Copy ${s.label} command`}
                      title={`Copy ${s.label} command`}
                    >
                      <Copy class="copy-icon" size={16} aria-hidden="true" />
                      <Check class="check-icon" size={16} aria-hidden="true" />
                    </button>
                  </div>
                  <div class="code-wrap">
                    <pre class="code">{s.code}</pre>
                  </div>
                </div>
              ))
            }
          </div>
          <p class="quickstart-more">
            See the <a href="/quick-start/">Quick Start</a>, or
            <a href="/guides/build-your-social-media-app/">Build Your Social Media App</a> to go deeper.
          </p>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta">
        <div class="cta-inner">
          <h2>Start building</h2>
          <p>
            The reference covers concepts, architecture, and hands-on guides — from a single write to a
            million reads per minute.
          </p>
          <div class="cta-row cta-center">
            <a class="btn btn-primary" href="/quick-start/">Quick Start</a>
            <a class="btn btn-outline" href="/introduction/">Explore docs</a>
          </div>
        </div>
      </section>
      </main>

      <!-- footer -->
      <footer class="footer">
        <div class="footer-inner">
          <span>© 2026 Kakao Corp. · Apache-2.0</span>
          <div class="footer-links">
            <a href="/introduction/">Docs</a>
            <a href="/stories/">Stories</a>
            <a href={repo} aria-label="GitHub">
              <svg class="gh-icon" viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
              </svg>
            </a>
          </div>
        </div>
      </footer>
    </div>

    <style is:global>
      :root {
        --accent: #5d5fef;
        --accent-hover: #4749d0;
        --accent-2: #a9aaf5;
        --accent-fill: rgba(93, 95, 239, 0.12);

        --btn-text: #ffffff;

        /* terminal / code — identical in both themes */
        --term-bg: #1b1c2b;
        --term-text: #e6e7f2;
        --term-prompt: #a9aaf5;
        --term-banner: #d9a94e;
        --term-dot: #33354a;
        --out-ok: #7fd1b0;
        --out-dim: #9092ab;
        --out-err: #e0a06a;

        --font-head: 'Cormorant', Georgia, serif;
        --font-body: 'Manrope', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, monospace;

        --maxw: 1280px;
        --gutter: 34px;
      }

      :root[data-theme='light'] {
        /* AA text-on-page-bg variants of the accent (the raw --accent fails
           4.5:1 as small text on both page backgrounds). */
        --accent-text: #4749d0;
        --accent-text-hover: #3a3cb8;
        --ink: #20223a;
        --body: #4e5168;
        --muted: #61657c;
        --line-soft: rgba(32, 34, 58, 0.12);
        --line-mid: rgba(32, 34, 58, 0.16);
        --line-24: rgba(32, 34, 58, 0.24);
        --line-strong: rgba(32, 34, 58, 0.28);
        --surf-card: rgba(255, 255, 255, 0.85);
        --surf-soft: rgba(255, 255, 255, 0.62);
        --surf-panel: rgba(255, 255, 255, 0.5);
        --surf-foot: rgba(230, 232, 240, 0.7);
        --grid-line: rgba(32, 34, 58, 0.05);
        --page-bg: linear-gradient(180deg, #f3f5f8 0%, #e9ecf1 100%);
        --page-bg-solid: #f3f5f8;
      }

      :root[data-theme='dark'] {
        --accent-text: #a9aaf5;
        --accent-text-hover: #c6c7fa;
        --ink: #ecedf6;
        --body: #b4b7cc;
        --muted: #9da0b7;
        --line-soft: rgba(255, 255, 255, 0.1);
        --line-mid: rgba(255, 255, 255, 0.16);
        --line-24: rgba(255, 255, 255, 0.22);
        --line-strong: rgba(255, 255, 255, 0.26);
        --surf-card: rgba(255, 255, 255, 0.05);
        --surf-soft: rgba(255, 255, 255, 0.04);
        --surf-panel: rgba(255, 255, 255, 0.03);
        --surf-foot: rgba(0, 0, 0, 0.28);
        --grid-line: rgba(255, 255, 255, 0.05);
        --page-bg: linear-gradient(180deg, #141520 0%, #0e0f17 100%);
        --page-bg-solid: #141520;
      }

      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        /* Carry the page gradient up to the root so over-scroll (rubber-band)
           never flashes the white canvas, and disable the bounce as well. */
        background: var(--page-bg);
        background-attachment: fixed;
        overscroll-behavior: none;
      }
      html {
        background-color: var(--page-bg-solid);
      }
      body {
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      .page {
        min-height: 100vh;
        color: var(--ink);
        font-family: var(--font-body);
        background: var(--page-bg);
      }

      a {
        color: var(--accent-text);
        text-decoration: none;
      }
      a:hover {
        color: var(--accent-text-hover);
      }
      :focus-visible {
        outline: 2px solid var(--accent-text);
        outline-offset: 2px;
      }

      .skip-link {
        position: absolute;
        top: -100px;
        left: var(--gutter);
        z-index: 10;
        padding: 10px 16px;
        background: var(--accent);
        color: var(--btn-text);
        font-size: 14px;
        font-weight: 600;
      }
      .skip-link:focus {
        top: 8px;
        color: var(--btn-text);
      }
      ::selection {
        background: var(--accent);
        color: #fff;
      }

      .accent {
        color: var(--accent);
      }

      /* nav */
      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px var(--gutter);
        max-width: var(--maxw);
        margin: 0 auto;
      }
      .brand {
        display: flex;
        align-items: center;
        color: var(--ink);
      }
      .brand-logo {
        height: 26px;
        width: auto;
        display: block;
      }
      :root[data-theme='light'] .brand-logo-dark {
        display: none;
      }
      :root[data-theme='dark'] .brand-logo-light {
        display: none;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 14px;
        font-weight: 600;
        color: var(--body);
      }
      .nav-links a {
        color: var(--body);
      }
      .nav-links a:hover {
        color: var(--ink);
      }
      .nav-text-link {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0 6px;
      }
      .gh-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 999px;
        border: 1px solid var(--line-mid);
        color: var(--body);
      }
      .gh-link:hover {
        border-color: var(--ink);
        color: var(--ink);
      }
      .gh-icon {
        display: block;
        width: 18px;
        height: 18px;
      }
      .theme-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 999px;
        border: 1px solid var(--line-mid);
        background: transparent;
        color: var(--body);
        cursor: pointer;
        font-size: 14px;
      }
      .theme-toggle:hover {
        border-color: var(--line-strong);
      }

      /* hero */
      .hero {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 48px var(--gutter) 40px;
      }
      .hero-copy {
        max-width: 1000px;
      }
      /* "Try it" section: [console | graph] over a horizontal control bar */
      .demo {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 60px var(--gutter) 20px;
      }
      .demo-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 22px;
      }
      .demo-head h2 {
        font-family: var(--font-head);
        font-weight: 700;
        font-size: 34px;
        letter-spacing: -0.02em;
        margin: 0;
      }
      .demo-reset {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 44px;
        background: none;
        border: 1px solid var(--line-mid);
        padding: 8px 13px;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.06em;
        color: var(--accent-text);
        cursor: pointer;
      }
      .demo-reset:hover {
        border-color: var(--accent);
      }
      .demo-panels {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 24px;
        align-items: stretch;
        margin-bottom: 20px;
      }
      .demo-controls {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }
      .tabs {
        display: flex;
        gap: 4px;
        border-bottom: 1px solid var(--line-soft);
      }
      .tab {
        margin-bottom: -1px;
        padding: 8px 14px;
        background: none;
        border: none;
        border-bottom: 2px solid transparent;
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        cursor: pointer;
      }
      .tab.active {
        color: var(--ink);
        border-bottom-color: var(--accent);
      }
      .tab-panel[hidden] {
        display: none;
      }
      .soon-heading {
        display: none;
      }
      .title {
        font-family: var(--font-head);
        font-weight: 700;
        font-size: 60px;
        line-height: 1;
        letter-spacing: -0.03em;
        margin: 0 0 22px;
        text-wrap: balance;
      }
      .lede {
        font-size: 19px;
        line-height: 1.58;
        color: var(--body);
        margin: 0 0 34px;
        text-wrap: pretty;
      }
      .cta-row {
        display: flex;
        gap: 14px;
        align-items: center;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        font-weight: 700;
        font-size: 15px;
      }
      .btn-primary {
        padding: 14px 26px;
        background: var(--accent);
        color: var(--btn-text);
      }
      .btn-primary:hover {
        background: var(--accent-hover);
        color: var(--btn-text);
      }
      .btn-outline {
        padding: 13px 24px;
        border: 1.5px solid var(--line-strong);
        color: var(--ink);
      }
      .btn-outline:hover {
        color: var(--ink);
        border-color: var(--ink);
      }
      /* edge-state graph — dotted board, card nodes, animated active edges */
      .graph {
        margin: 0;
        display: flex;
        flex-direction: column;
        background-image: radial-gradient(var(--grid-line) 1.3px, transparent 1.3px);
        background-size: 22px 22px;
      }
      .graph-cap {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 14px;
      }
      .graph-svg {
        width: 100%;
        height: auto;
        margin: auto 0;
        max-height: 320px;
        overflow: visible;
      }
      .gnode rect {
        fill: var(--surf-card);
        stroke: var(--line-mid);
        stroke-width: 1.2;
        transition:
          stroke 0.3s,
          opacity 0.3s,
          filter 0.3s;
      }
      .gn-name {
        fill: var(--ink);
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 14px;
        text-anchor: middle;
        transition: fill 0.3s;
      }
      .gn-type {
        fill: var(--muted);
        font-family: var(--font-mono);
        font-size: 7.5px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        text-anchor: middle;
      }
      .gedge line {
        stroke: var(--line-mid);
        stroke-width: 1.6;
        stroke-linecap: round;
        transition:
          stroke 0.3s,
          stroke-width 0.3s,
          opacity 0.3s;
      }
      .gedge-label {
        fill: var(--muted);
        font-family: var(--font-mono);
        font-size: 7px;
        letter-spacing: 0.04em;
        text-anchor: middle;
        transition: fill 0.3s;
      }
      .gedge.on .gedge-label {
        fill: var(--accent-text);
      }
      /* count numbering: the label becomes the ordinal (1, 2, …) on each edge */
      .gedge-label.num {
        fill: var(--accent-text);
        font-size: 10px;
        font-weight: 700;
      }
      /* reactive states, toggled from the console */
      .gnode.dim,
      .gedge.dim {
        opacity: 0.28;
      }
      .gedge.on line {
        stroke: var(--accent);
        stroke-width: 2.2;
        stroke-dasharray: 7 5;
        animation: dashmove 0.55s linear infinite;
      }
      @keyframes dashmove {
        to {
          stroke-dashoffset: -12;
        }
      }
      .gnode.on rect {
        stroke: var(--accent);
        stroke-width: 1.6;
        filter: drop-shadow(0 6px 16px rgba(93, 95, 239, 0.34));
      }
      .gnode.on .gn-name {
        fill: var(--accent-text);
      }
      /* console */
      .console {
        margin: 0;
      }
      /* Shared frame for the three demo cells (console, graph, controls) so
         they read as one set; the dark console just sits inside its panel. */
      .panel {
        padding: 20px;
        background: var(--surf-soft);
        border: 1px solid var(--line-soft);
      }
      .term {
        background: var(--term-bg);
        box-shadow: inset 0 2px 12px rgba(0, 0, 0, 0.55);
      }
      .term-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 11px 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }
      .dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #3a3330;
      }
      .term-title {
        margin-left: 8px;
        font-family: var(--font-mono);
        font-size: 11px;
        color: #8a8ca0;
      }
      .term-body {
        padding: 16px;
        height: 294px;
        /* Block scroll container so content keeps its natural height and
           overflows (a flex column would instead shrink the banner to fit).
           overflow:hidden means the user can't scroll or drag it — only the JS
           below moves it, pinning the view to the bottom after each command so
           the prompt stays put and the banner scrolls off. user-select:none
           stops drag-selection inside the console. */
        overflow: hidden;
        user-select: none;
        font-family: var(--font-mono);
        font-size: 12.5px;
        /* terminal-tight leading so table borders (| ---) connect like the real CLI */
        line-height: 1.35;
        color: var(--term-text);
      }
      .banner {
        margin: 0 0 10px;
        padding: 0;
        /* Otter body = default terminal foreground; gold runs opt in via .g. */
        color: var(--term-text);
        font-family: var(--font-mono);
        font-size: 6.5px;
        /* 2:1 cell aspect (7.8px over 3.9px) matches a real terminal, so the
           otter strokes and box borders connect the way the art was drawn */
        line-height: 1.2;
        white-space: pre;
        overflow: hidden;
      }
      .banner .g {
        color: var(--term-banner);
      }
      .line {
        display: flex;
        gap: 8px;
      }
      .line .prompt {
        color: var(--accent-2);
        flex: none;
      }
      .l {
        white-space: pre-wrap;
        word-break: break-word;
      }
      .l-cmd,
      .l-out {
        color: var(--term-text);
      }
      .l-ok {
        color: var(--out-ok);
      }
      .l-dim,
      .l-sys {
        color: var(--out-dim);
      }
      .l-err {
        color: var(--out-err);
      }
      .input-row {
        display: flex;
        gap: 8px;
        align-items: center;
        margin-top: 2px;
      }
      .input-row .prompt {
        color: var(--accent-2);
        flex: none;
      }
      .term-cursor {
        display: inline-block;
        width: 7px;
        height: 15px;
        background: var(--term-text);
        animation: term-blink 1.1s steps(1) infinite;
      }
      @keyframes term-blink {
        50% {
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .term-cursor,
        .gedge.on line {
          animation: none;
        }
      }
      .term-hint {
        color: var(--out-dim);
      }
      .presets {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .preset {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 3px;
        text-align: left;
        background: var(--surf-card);
        border: 1px solid var(--line-mid);
        padding: 9px 11px;
        cursor: pointer;
      }
      .preset-cmd {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--body);
      }
      .preset-desc {
        font-family: var(--font-body);
        font-size: 11px;
        color: var(--muted);
      }
      .preset:hover:not(:disabled) {
        border-color: var(--line-strong);
      }
      .preset:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
      .preset.active {
        border-color: var(--accent);
        background: var(--accent-fill);
      }
      .preset.active .preset-cmd {
        color: var(--accent-text);
      }
      /* teaser: query ops that aren't shipped yet, shown disabled with a TBD tag */
      .preset-soon {
        padding-right: 46px;
      }
      .preset-soon:disabled {
        opacity: 0.6;
      }
      .tbd {
        position: absolute;
        top: 8px;
        right: 10px;
        font-size: 9px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        border: 1px solid var(--line-mid);
        padding: 1px 5px;
      }

      /* trust band */
      .band {
        border-top: 1px solid var(--line-soft);
        border-bottom: 1px solid var(--line-soft);
        background: var(--surf-soft);
      }
      .band-inner {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 30px var(--gutter);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
      }
      .band-statement {
        margin: 0;
        font-family: var(--font-head);
        font-weight: 500;
        font-size: 24px;
        line-height: 1.3;
        color: var(--ink);
      }
      .tags {
        display: flex;
        gap: 12px;
      }
      .tag {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        color: var(--muted);
      }

      /* sections */
      .section {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 74px var(--gutter) 44px;
      }
      .section-head {
        display: flex;
        align-items: baseline;
        gap: 16px;
        margin-bottom: 38px;
      }
      .section-head h2 {
        font-family: var(--font-head);
        font-weight: 700;
        font-size: 34px;
        letter-spacing: -0.02em;
        margin: 0;
      }
      .kicker {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
      }

      /* feature cards */
      .feature-section {
        padding-top: 72px;
      }
      .feature-group + .feature-group {
        margin-top: 34px;
      }
      .feature-group-label {
        display: block;
        margin-bottom: 12px;
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }
      .card {
        /* Vertical stripes only — no grid crosslines, no gradient wash. */
        background-color: var(--surf-soft);
        background-image: linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
        background-size: 28px 100%;
        border: 1px solid var(--line-soft);
        padding: 24px 22px;
        min-height: 148px;
        box-shadow: 0 16px 34px -26px rgba(35, 37, 75, 0.4);
      }
      .card-primary {
        border-top: 2px solid var(--accent);
      }
      .card-secondary {
        min-height: 132px;
        background-image: none;
        box-shadow: none;
      }
      .card-num {
        display: block;
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.1em;
        color: var(--accent-text);
        margin-bottom: 12px;
      }
      .card h3 {
        margin: 0 0 8px;
        font-size: 16px;
        font-weight: 700;
        letter-spacing: -0.01em;
      }
      .card p {
        margin: 0;
        font-size: 14px;
        line-height: 1.5;
        color: var(--body);
        text-wrap: pretty;
      }

      /* architecture */
      .arch {
        padding-top: 26px;
        padding-bottom: 74px;
      }
      .arch-panel {
        border: 1px solid var(--line-mid);
        background: var(--surf-soft);
        padding: 32px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .arch-svg {
        width: 100%;
        max-width: 720px;
        height: auto;
        display: block;
      }
      .arch-box {
        fill: var(--surf-card);
        stroke: var(--line-mid);
        stroke-width: 1;
      }
      .arch-box-accent {
        stroke: var(--accent);
        stroke-width: 2;
      }
      .arch-t {
        fill: var(--ink);
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 13px;
        text-anchor: middle;
      }
      .arch-t-accent {
        fill: var(--accent-text);
      }
      .arch-req {
        fill: var(--accent-text);
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 11px;
        text-anchor: middle;
      }
      .arch-sub {
        fill: var(--muted);
        font-family: var(--font-mono);
        font-size: 9.5px;
        text-anchor: middle;
      }
      .arch-line {
        fill: none;
        stroke: var(--line-strong);
        stroke-width: 1.5;
      }
      .arch-lbl {
        fill: var(--muted);
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.1em;
        text-anchor: middle;
      }
      .arch-lbl-rest {
        text-anchor: start;
      }

      /* quick start */
      .quickstart {
        border-top: 1px solid var(--line-soft);
        background: var(--surf-panel);
      }
      .quickstart-inner {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 74px var(--gutter);
      }
      .steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
      }
      .step {
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .step-head {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
        min-height: 36px;
      }
      .step-num {
        font-family: var(--font-mono);
        font-weight: 700;
        font-size: 15px;
        color: var(--accent-text);
      }
      .step-label {
        font-size: 14px;
        font-weight: 700;
      }
      .code-wrap {
        display: flex;
        flex: 1;
        min-width: 0;
        overflow: hidden;
        border-radius: 10px;
        background: var(--term-bg);
      }
      .code {
        margin: 0;
        flex: 1;
        min-width: 0;
        background: transparent;
        color: var(--term-text);
        padding: 14px;
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 1.6;
        white-space: pre;
        overflow-x: auto;
      }
      .copy-code {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border: 1px solid var(--line-mid);
        border-radius: 6px;
        background: var(--surf-soft);
        color: var(--body);
        cursor: pointer;
      }
      .copy-code:hover {
        color: var(--ink);
        border-color: var(--line-strong);
      }
      .copy-code .check-icon {
        display: none;
      }
      .copy-code.copied {
        color: var(--out-ok);
      }
      .copy-code.copied .copy-icon {
        display: none;
      }
      .copy-code.copied .check-icon {
        display: block;
      }
      .quickstart-more {
        margin: 24px 0 0;
        font-size: 14px;
        color: var(--body);
      }
      /* In-paragraph links must not rely on colour alone (WCAG 1.4.1). */
      .quickstart-more a {
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      /* CTA */
      .cta {
        border-top: 1px solid var(--line-soft);
      }
      .cta-inner {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 90px var(--gutter);
        text-align: center;
      }
      .cta-inner h2 {
        font-family: var(--font-head);
        font-weight: 700;
        font-size: 48px;
        letter-spacing: -0.03em;
        margin: 0 0 14px;
      }
      .cta-inner p {
        font-size: 18px;
        color: var(--body);
        margin: 0 auto 34px;
        max-width: 46ch;
        text-wrap: pretty;
      }
      .cta-center {
        justify-content: center;
      }

      /* footer */
      .footer {
        border-top: 1px solid var(--line-soft);
        background: var(--surf-foot);
      }
      .footer-inner {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: var(--gutter);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--muted);
      }
      .footer-links {
        display: flex;
        align-items: center;
        gap: 22px;
      }
      .footer-links a {
        color: var(--muted);
      }
      .footer-links a:hover {
        color: var(--ink);
      }

      /* On desktop the console fills its panel row to match the graph height.
         Its content is taken out of flow (absolute) so running commands never
         grows the cell — the body just clips (overflow:hidden) and auto-scrolls.
         Mobile keeps the fixed body height. */
      @media (min-width: 901px) {
        .term-fill {
          position: relative;
        }
        .term-fill [data-console] {
          position: absolute;
          inset: 0;
          display: flex;
          flex-direction: column;
        }
        .term-fill .term {
          flex: 1 1 0;
          min-height: 0;
          display: flex;
          flex-direction: column;
        }
        .term-fill .term-body {
          flex: 1 1 0;
          min-height: 0;
          height: auto;
        }
        /* full-width rows: command on the left, dimmed description on the right */
        .preset {
          flex-direction: row;
          align-items: center;
          justify-content: space-between;
          gap: 16px;
        }
        .preset-desc {
          text-align: right;
        }
      }

      /* responsive */
      /* Stack the console/graph earlier than the global breakpoint so the wide
         result tables never get squeezed while side-by-side. */
      @media (max-width: 1080px) {
        .demo-panels {
          grid-template-columns: 1fr;
        }
      }
      @media (max-width: 900px) {
        :root {
          --gutter: 24px;
        }
        .title {
          font-size: 44px;
        }
        .demo {
          display: flex;
          flex-direction: column;
        }
        .demo-head {
          order: 0;
        }
        .demo-controls {
          order: 1;
          margin-bottom: 24px;
        }
        .demo-panels {
          order: 2;
          min-width: 0;
          margin-bottom: 0;
        }
        .demo-panels > *,
        .console,
        .term-fill,
        .term-fill [data-console],
        .term {
          width: 100%;
          min-width: 0;
          max-width: 100%;
        }
        .graph {
          order: 1;
        }
        .console {
          order: 2;
          overflow: hidden;
        }
        /* Keep runnable commands directly before the visualization. */
        .tabs {
          display: none;
        }
        .tab-panel[data-panel='soon'] {
          display: none !important;
        }
        .features,
        .steps {
          grid-template-columns: minmax(0, 1fr);
        }
      }
      @media (max-width: 700px) {
        .band-inner {
          align-items: flex-start;
          flex-direction: column;
        }
        .tags {
          flex-wrap: wrap;
        }
        .arch-panel {
          padding: 14px;
        }
      }
      @media (max-width: 560px) {
        :root {
          --gutter: 20px;
        }
        .nav {
          padding-block: 18px;
        }
        .brand-logo {
          height: 22px;
        }
        .nav-links {
          gap: 4px;
          font-size: 13px;
        }
        .gh-link {
          display: none;
        }
        .hero {
          padding-top: 38px;
        }
        .title {
          font-size: 36px;
        }
        .lede {
          font-size: 17px;
        }
        .demo {
          padding-top: 52px;
        }
        .demo-head {
          align-items: center;
        }
        .demo-head h2 {
          font-size: 31px;
        }
        .term-body {
          height: 240px;
          padding: 14px;
          font-size: 11px;
        }
        .banner {
          display: none;
        }
        .input-row {
          flex-wrap: wrap;
        }
        .preset {
          min-height: 52px;
        }
        .section-head {
          align-items: flex-start;
          flex-direction: column;
          gap: 8px;
        }
        .feature-group + .feature-group {
          margin-top: 26px;
        }
        .card {
          min-height: 0;
        }
        .code {
          font-size: 11px;
          white-space: pre-wrap;
          overflow-wrap: anywhere;
        }
        .cta-inner h2 {
          font-size: 34px;
        }
        .footer-inner {
          padding-block: 24px;
        }
      }
      @media (max-width: 360px) {
        .nav-stories {
          display: none;
        }
      }
    </style>

    <script>
      // Theme toggle — writes Starlight's key so the preference carries into docs.
      const root = document.documentElement;
      const icon = document.querySelector('[data-theme-icon]');
      const syncIcon = () => {
        if (icon) icon.textContent = root.dataset.theme === 'dark' ? '☀' : '☾';
      };
      syncIcon();
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {
          /* ignore */
        }
        syncIcon();
        window.dispatchEvent(new Event('theme-change'));
      });

      // Console — a self-contained command parser over an in-memory edge set.
      const consoleEl = document.querySelector('[data-console]');
      if (consoleEl) {
        const linesEl = consoleEl.querySelector('[data-lines]');
        const initialLinesHTML = linesEl.innerHTML;
        const bodyEl = consoleEl.querySelector('.term-body');
        // Keep the newest output (and the banner scrolling off the top) in view.
        const scrollToEnd = () => {
          if (bodyEl) bodyEl.scrollTop = bodyEl.scrollHeight;
        };
        // Edge-state graph — the console drives it so a command's meaning is
        // visible: get highlights one edge, scan/count highlight a fan of them.
        const graphEl = document.querySelector('[data-graph]');
        const gEdges = graphEl ? [...graphEl.querySelectorAll('.gedge')] : [];
        const gNodes = graphEl ? [...graphEl.querySelectorAll('.gnode')] : [];

        // every edge label reads "likes" until count numbers the matched ones 1, 2, …
        const resetLabels = () => {
          gEdges.forEach((e) => {
            const t = e.querySelector('.gedge-label');
            if (t) {
              t.textContent = 'likes';
              t.classList.remove('num');
            }
          });
        };
        const focusGraph = (edgeIds, nodeIds) => {
          const es = new Set(edgeIds);
          const ns = new Set(nodeIds);
          gEdges.forEach((e) => {
            const on = es.has(e.dataset.edge);
            e.classList.toggle('on', on);
            e.classList.toggle('dim', !on);
          });
          gNodes.forEach((n) => {
            const on = ns.has(n.dataset.node);
            n.classList.toggle('on', on);
            n.classList.toggle('dim', !on);
          });
          resetLabels();
        };
        // count: label the matched edges 1, 2, … so the total reads off the graph
        const numberEdges = (edgeIds) => {
          edgeIds.forEach((id, i) => {
            const el = gEdges.find((e) => e.dataset.edge === id);
            const t = el && el.querySelector('.gedge-label');
            if (t) {
              t.textContent = String(i + 1);
              t.classList.add('num');
            }
          });
        };

        const addLine = (kind, text, withPrompt) => {
          const row = document.createElement('div');
          row.className = 'line';
          if (withPrompt) {
            const p = document.createElement('span');
            p.className = 'prompt';
            p.textContent = 'actionbase(likes:likes)>';
            row.appendChild(p);
          }
          const span = document.createElement('span');
          span.className = 'l l-' + kind;
          span.textContent = text;
          row.appendChild(span);
          linesEl.appendChild(row);
          scrollToEnd();
        };

        // Output mirrors the real CLI for the three preset commands (fixed
        // dataset), down to the request line, result table and timing.
        const OUT = {
          get: [
            '  │ → GET /graph/v3/databases/likes/tables/likes/edges/get?source=Alice&target=Phone',
            '  │ ← 200 OK {"edges":[{"version":1784793660730,"source":"Alice","targ...',
            '  │',
            '  │ The edge is found: [Alice -> Phone]',
            '  │ |---------------|--------|--------|---------------------------|',
            '  │ | VERSION       | SOURCE | TARGET | PROPERTIES                |',
            '  │ |---------------|--------|--------|---------------------------|',
            '  │ | 1784793660730 | Alice  | Phone  | created_at: 1784793660730 |',
            '  │ |---------------|--------|--------|---------------------------|',
            '  │ (Took 0.0824 seconds)',
            '  │',
          ],
          scan: [
            '  │ → GET /graph/v3/databases/likes/tables/likes/edges/scan/recent?direction=OUT&limit=25&start=Bob',
            '  │ ← 200 OK {"edges":[{"version":1784793660730,"source":"Bob","target...',
            '  │ The 2 edges found (offset: -, hasNext: false)',
            '  │ |---|---------------|--------|--------|---------------------------|',
            '  │ | # | VERSION       | SOURCE | TARGET | PROPERTIES                |',
            '  │ |---|---------------|--------|--------|---------------------------|',
            '  │ | 1 | 1784793660730 | Bob    | Laptop | created_at: 1784793660730 |',
            '  │ | 2 | 1784793660730 | Bob    | Phone  | created_at: 1784793660730 |',
            '  │ |---|---------------|--------|--------|---------------------------|',
            '  │ (Took 0.0531 seconds)',
            '  │',
          ],
          count: [
            '  │ → GET /graph/v3/databases/likes/tables/likes/edges/counts?start=Phone&direction=IN',
            '  │ ← 200 OK {"counts":[{"start":"Phone","direction":"IN","count":2,"c...',
            '  │',
            '  │ The count of 1 edges found',
            '  │ |---|-------|-----------|-------|',
            '  │ | # | START | DIRECTION | COUNT |',
            '  │ |---|-------|-----------|-------|',
            '  │ | 1 | Phone | IN        | 2     |',
            '  │ |---|-------|-----------|-------|',
            '  │ (Took 0.0477 seconds)',
            '  │',
          ],
        };

        const run = (raw) => {
          const cmd = (raw || '').trim().split(/\s+/)[0].toLowerCase();
          if (!OUT[cmd]) return;
          addLine('cmd', raw, true);
          OUT[cmd].forEach((t) => addLine('dim', t));
          if (cmd === 'get') {
            focusGraph(['alice-phone'], ['alice', 'phone']);
          } else if (cmd === 'scan') {
            focusGraph(['bob-phone', 'bob-laptop'], ['bob', 'phone', 'laptop']);
          } else if (cmd === 'count') {
            focusGraph(['alice-phone', 'bob-phone'], ['alice', 'bob', 'phone']);
            numberEdges(['alice-phone', 'bob-phone']);
          }
        };

        // Any step runs on click — no forced order. The clicked button takes an
        // active state; TBD teasers stay disabled via markup.
        const stepButtons = [...document.querySelectorAll('[data-step]')];
        stepButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            stepButtons.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            run(btn.getAttribute('data-cmd'));
          });
        });

        // Reset: restore the opening console output and clear the graph state.
        const resetButton = document.querySelector('[data-reset]');
        resetButton?.addEventListener('click', () => {
          linesEl.innerHTML = initialLinesHTML;
          gEdges.forEach((e) => e.classList.remove('on', 'dim'));
          gNodes.forEach((n) => n.classList.remove('on', 'dim'));
          resetLabels();
          stepButtons.forEach((b) => b.classList.remove('active'));
          scrollToEnd();
        });
        // Pin to the bottom now, on the next frame, and again once the tiny
        // 6.5px banner webfont swaps in (which changes the scroll height).
        scrollToEnd();
        requestAnimationFrame(scrollToEnd);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(scrollToEnd);
      }

      // Try-it tabs: switch between the supported and coming-soon panels.
      const tabList = document.querySelector('[data-tabs]');
      if (tabList) {
        const tabs = [...tabList.querySelectorAll('.tab')];
        const panels = [...document.querySelectorAll('.tab-panel')];
        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const name = tab.dataset.tab;
            tabs.forEach((t) => {
              const on = t === tab;
              t.classList.toggle('active', on);
              t.setAttribute('aria-pressed', String(on));
            });
            panels.forEach((p) => {
              p.hidden = p.dataset.panel !== name;
            });
          });
        });
      }

      document.querySelectorAll('[data-copy-code]').forEach((button) => {
        const idleLabel = button.getAttribute('aria-label') || 'Copy command';
        button.addEventListener('click', async () => {
          const code = button.getAttribute('data-copy-code') || '';
          try {
            await navigator.clipboard.writeText(code);
            button.classList.add('copied');
            button.setAttribute('aria-label', 'Copied');
            window.setTimeout(() => {
              button.classList.remove('copied');
              button.setAttribute('aria-label', idleLabel);
            }, 1600);
          } catch {
            button.setAttribute('aria-label', 'Copy failed');
          }
        });
      });
    </script>
  </body>
</html>
