---
import logoLight from '../assets/logo-light.svg?url';
import logoDark from '../assets/logo-dark.svg?url';

// Standalone marketing landing. Kept outside Starlight's content collection so
// the bespoke chrome (marginalia, hero console, architecture flow) has full
// layout control; theme state still syncs with Starlight via the shared
// `starlight-theme` localStorage key and `<html data-theme>` attribute.

const GA_ID = 'G-2PY5JXRJ5J';
const site = 'https://actionbase.io/';
const ogUrl = new URL('og.png?v=1', site).href;
const ogImageAlt =
  'Actionbase is a production-proven OLTP database serving tens of millions of users across Kakao.';
const repo = 'https://github.com/kakao/actionbase';

// ASCII otter banner, coloured to mirror the real CLI welcome art (ANSI 33):
// the otter body stays the default terminal foreground; the frame, the heart,
// the right-hand info labels and the "Actionbase" wordmark are gold. Each line
// is a list of [text, gold?] segments — concatenated they reproduce the raw
// art, and gold runs are wrapped in a <span class="g"> at build time.
const BANNER_WIDTH = 98;
const G = true;
const bannerSegs = [
  [['', false]],
  [['                    _____________', false]],
  [['                 __/      ___    \\        Welcome to Actionbase! v0.2.1', false]],
  [['               _/\\   ____/   \\____\\_', false]],
  [['              / \\/ _/      @    \\_', false], ['♥/', G], ['\\     ', false], ['Actionbase  standalone:8080', G]],
  [['             /   /                | |', false]],
  [['           _/   /             ___/ \\/     ', false], ['proxy', G], ['  off', false]],
  [['          /     |           ______/       ', false], ['debug', G], ['  off', false]],
  [['       __/      |          /', false]],
  [['   ___/         \\        _/', false]],
  [['                 |      /\\__', false]],
  [['                 |     /    \\__', false], ['          _        _   _             _', G]],
  [['                 |    /______  \\', false], ['        / \\   ___| |_(_) ___  _ __ | |__   __ _ ___  ___', G]],
  [["              \\   \\_         \\  \\", false], ["      / _ \\ / __| __| |/ _ \\| '_ \\| '_ \\ / _` / __|/ _ \\", G]],
  [["               \\__  \\__       |_|", false], ["     / ___ \\ (__| |_| | (_) | | | | |_) | (_| \\__ \\  __/", G]],
  [['                  \\____\\', false], ['              /_/   \\_\\___|\\__|_|\\___/|_| |_|_.__/ \\__,_|___/\\___|', G]],
  [['', false]],
];
const escHtml = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const goldSpan = (s) => `<span class="g">${escHtml(s)}</span>`;
const bannerLine = (segs) => {
  const raw = segs.map(([t]) => t).join('');
  const pad = ' '.repeat(Math.max(0, BANNER_WIDTH - raw.length));
  const inner = segs.map(([t, g]) => (g ? goldSpan(t) : escHtml(t))).join('') + pad;
  return goldSpan('│') + inner + goldSpan('│');
};
const banner = [
  goldSpan('╭' + '─'.repeat(BANNER_WIDTH) + '╮'),
  ...bannerSegs.map(bannerLine),
  goldSpan('╰' + '─'.repeat(BANNER_WIDTH) + '╯'),
].join('\n');

const features = [
  { title: 'Pre-computed Reads', desc: 'Writes do the work. Reads return what’s already computed.' },
  { title: 'U2U · U2I · I2I', desc: 'One model for user–user, user–item, and item–item interactions.' },
  { title: 'REST API', desc: 'Simple writes, fast reads — all via HTTP.' },
  { title: 'CDC Built-in', desc: 'Stream changes for downstream pipelines.' },
  { title: 'Pluggable Storage', desc: 'A minimal storage abstraction — HBase today, SlateDB planned.' },
  { title: 'Battle-tested', desc: 'Over a million requests per minute at Kakao.' },
];

// Both paths converge on one wide Storage Backend. Kafka sits on the write side
// only (WAL in, CDC out); the read path (Query doc) is a direct lookup.
const writeNode = { name: 'Kafka', sub: 'WAL in · CDC out' };
const readNode = { name: 'GET · COUNT · SCAN', sub: 'direct REST lookups' };
const storageNode = { name: 'Storage Backend', sub: 'state · index · count — HBase / SlateDB' };

const steps = [
  { n: '1', label: 'Run', code: 'docker run -it \\\n  ghcr.io/kakao/actionbase:standalone' },
  { n: '2', label: 'Load sample data', code: 'load preset likes' },
  {
    n: '3',
    label: 'Query — just read',
    code: 'get   --source Alice --target Phone\nscan  --index recent --start Bob --direction OUT\ncount --start Phone --direction IN',
  },
];

const presets = [
  'get --source Alice --target Phone',
  'scan --index recent --start Bob --direction OUT',
  'count --start Phone --direction IN',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Actionbase</title>
    <meta name="description" content="A database for serving user interactions at scale." />
    <link rel="icon" class="js-site-favicon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Apply persisted theme before paint to avoid a flash; shares Starlight's key. -->
    <script is:inline>
      (function () {
        const stored = typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <script is:inline>
      (function () {
        const updateFavicon = () => {
          const isDark = document.documentElement.dataset.theme === 'dark';
          const favicon = document.querySelector('.js-site-favicon');
          if (favicon) favicon.href = isDark ? '/favicon-dark.svg' : '/favicon.svg';
        };
        updateFavicon();
        window.addEventListener('theme-change', updateFavicon);
      })();
    </script>

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>
  </head>

  <body>
    <div class="page">
      <!-- nav -->
      <nav class="nav">
        <a class="brand" href="/">
          <img class="brand-logo brand-logo-light" src={logoLight} alt="Actionbase" width="109" height="26" />
          <img class="brand-logo brand-logo-dark" src={logoDark} alt="Actionbase" width="109" height="26" />
        </a>
        <div class="nav-links">
          <a href={repo} class="gh-link">GitHub <span class="gh-stars" hidden>★ <span data-gh-count></span></span></a>
          <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle color theme">
            <span data-theme-icon>☾</span>
          </button>
        </div>
      </nav>

      <!-- hero -->
      <header class="hero">
        <div class="hero-copy">
          <h1 class="title">One database for follows, likes, <span class="accent">and related items</span></h1>
          <p class="lede">
            Pre-computed at write time, served in real-time. Reads become simple lookups — no read-time
            aggregation.
          </p>
          <div class="cta-row">
            <a class="btn btn-primary" href="/introduction/">Get started</a>
            <a class="btn btn-outline" href={repo}>View on GitHub</a>
          </div>
        </div>

        <!-- live console -->
        <figure class="console">
          <div class="glass" data-console>
            <div class="term">
              <div class="term-bar">
                <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                <span class="term-title">actionbase cli</span>
              </div>
              <div class="term-body">
                <pre class="banner" set:html={banner}></pre>
                <div data-lines>
                  <div class="line"><span class="l l-sys">actionbase standalone · server :8080 · CLI ready</span></div>
                  <div class="line"><span class="l l-sys">preset 'likes' loaded — 3 edges</span></div>
                  <div class="line"><span class="l l-sys">Alice → Phone    Bob → Laptop    Bob → Phone</span></div>
                  <div class="line"><span class="l l-dim">run the steps below, in order ↓</span></div>
                </div>
                <div class="input-row">
                  <span class="prompt">actionbase&gt;</span>
                  <span class="term-cursor" aria-hidden="true"></span>
                  <span class="term-hint">run a step below ↓</span>
                </div>
              </div>
            </div>
          </div>
          <div class="presets">
            {presets.map((c, i) => (
              <button type="button" class="preset" data-step={i} data-cmd={c}>
                {c}
              </button>
            ))}
            <button type="button" class="preset preset-reset" data-reset hidden>↺ Reset</button>
          </div>
        </figure>
      </header>

      <!-- trust band -->
      <section class="band">
        <div class="band-inner">
          <p class="band-statement">
            Serving over <span class="accent">a million requests per minute</span>, in production at Kakao.
          </p>
          <div class="tags">
            <span class="tag">#real-time</span>
            <span class="tag">#low-latency</span>
            <span class="tag">#high-throughput</span>
          </div>
        </div>
      </section>

      <!-- under the hood -->
      <section class="section">
        <div class="section-head">
          <h2>Under the hood</h2>
          <span class="kicker">Writes do the work</span>
        </div>
        <div class="features">
          {
            features.map((f) => (
              <div class="card">
                <h3>{f.title}</h3>
                <p>{f.desc}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- architecture -->
      <section class="section arch">
        <div class="arch-kicker">
          <span>Architecture</span><span>Client → Actionbase → storage &amp; stream</span>
        </div>
        <div class="arch-panel">
          <div class="node">Client</div>
          <div class="connector"></div>
          <div class="arch-label">REST API · HTTP</div>
          <div class="connector"></div>
          <div class="node node-accent">Actionbase</div>
          <div class="connector"></div>
          <div class="arch-paths">
            <div class="arch-col arch-col--write">
              <div class="path-kicker">Write path · writes do the work</div>
              <div class="path-stack">
                <div class="connector"></div>
                <div class="node node-wide">
                  <span class="node-title">{writeNode.name}</span>
                  <span class="node-sub">{writeNode.sub}</span>
                </div>
                <div class="connector"></div>
              </div>
            </div>
            <div class="arch-col arch-col--read">
              <div class="path-kicker">Read path · simple lookups</div>
              <div class="path-stack">
                <div class="connector"></div>
                <div class="node node-wide">
                  <span class="node-title">{readNode.name}</span>
                  <span class="node-sub">{readNode.sub}</span>
                </div>
                <div class="connector"></div>
              </div>
            </div>
          </div>
          <div class="node node-shared arch-storage">
            <span class="node-title">{storageNode.name}</span>
            <span class="node-sub">{storageNode.sub}</span>
          </div>
        </div>
      </section>

      <!-- quick start -->
      <section class="quickstart">
        <div class="quickstart-inner">
          <div class="section-head">
            <h2>Quick start</h2>
            <span class="kicker">Three steps</span>
          </div>
          <div class="steps">
            {
              steps.map((s) => (
                <div class="step">
                  <div class="step-head">
                    <span class="step-num">{s.n}</span>
                    <span class="step-label">{s.label}</span>
                  </div>
                  <pre class="code">{s.code}</pre>
                </div>
              ))
            }
          </div>
          <p class="quickstart-more">
            See the <a href="/quick-start/">Quick Start</a>, or
            <a href="/guides/build-your-social-media-app/">Build Your Social Media App</a> to go deeper.
          </p>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta">
        <div class="cta-inner">
          <h2>Ready to build?</h2>
          <p>
            The reference covers concepts, architecture, and hands-on guides — from a single write to a
            million reads per minute.
          </p>
          <div class="cta-row cta-center">
            <a class="btn btn-primary" href="/introduction/">Read the docs</a>
            <a class="btn btn-outline" href={repo}>View on GitHub</a>
          </div>
        </div>
      </section>

      <!-- footer -->
      <footer class="footer">
        <div class="footer-inner">
          <span>© 2026 Kakao Corp. · Apache-2.0</span>
          <div class="footer-links">
            <a href={repo}>GitHub</a>
          </div>
        </div>
      </footer>
    </div>

    <style is:global>
      :root {
        --accent: #5d5fef;
        --accent-hover: #4749d0;
        --accent-2: #a9aaf5;
        --accent-fill: rgba(93, 95, 239, 0.12);

        --btn-text: #f5f6ff;

        /* terminal / code — identical in both themes */
        --term-bg: #1b1c2b;
        --term-text: #e6e7f2;
        --term-prompt: #a9aaf5;
        --term-banner: #d9a94e;
        --term-dot: #33354a;
        --glass: linear-gradient(155deg, #7c7ee8, #3e40a8);
        --out-ok: #7fd1b0;
        --out-dim: #9092ab;
        --out-err: #e0a06a;

        --font-head: 'Space Grotesk', system-ui, sans-serif;
        --font-body: 'Manrope', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, monospace;

        --maxw: 1280px;
        --gutter: 34px;
      }

      :root[data-theme='light'] {
        --ink: #20223a;
        --body: #4e5168;
        --muted: #82859b;
        --line-soft: rgba(32, 34, 58, 0.12);
        --line-mid: rgba(32, 34, 58, 0.16);
        --line-24: rgba(32, 34, 58, 0.24);
        --line-strong: rgba(32, 34, 58, 0.28);
        --surf-card: rgba(255, 255, 255, 0.85);
        --surf-soft: rgba(255, 255, 255, 0.62);
        --surf-panel: rgba(255, 255, 255, 0.5);
        --surf-foot: rgba(230, 232, 240, 0.7);
        --grid-line: rgba(32, 34, 58, 0.05);
        --page-bg: linear-gradient(180deg, #f3f5f8 0%, #e9ecf1 100%);
      }

      :root[data-theme='dark'] {
        --ink: #ecedf6;
        --body: #b4b7cc;
        --muted: #8a8da6;
        --line-soft: rgba(255, 255, 255, 0.1);
        --line-mid: rgba(255, 255, 255, 0.16);
        --line-24: rgba(255, 255, 255, 0.22);
        --line-strong: rgba(255, 255, 255, 0.26);
        --surf-card: rgba(255, 255, 255, 0.05);
        --surf-soft: rgba(255, 255, 255, 0.04);
        --surf-panel: rgba(255, 255, 255, 0.03);
        --surf-foot: rgba(0, 0, 0, 0.28);
        --grid-line: rgba(255, 255, 255, 0.05);
        --page-bg: linear-gradient(180deg, #141520 0%, #0e0f17 100%);
      }

      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
      }
      body {
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      .page {
        min-height: 100vh;
        color: var(--ink);
        font-family: var(--font-body);
        background: var(--page-bg);
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }
      a:hover {
        color: var(--accent-hover);
      }
      ::selection {
        background: var(--accent);
        color: #fff;
      }

      .accent {
        color: var(--accent);
      }

      /* nav */
      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px var(--gutter);
        max-width: var(--maxw);
        margin: 0 auto;
      }
      .brand {
        display: flex;
        align-items: center;
        color: var(--ink);
      }
      .brand-logo {
        height: 26px;
        width: auto;
        display: block;
      }
      :root[data-theme='light'] .brand-logo-dark {
        display: none;
      }
      :root[data-theme='dark'] .brand-logo-light {
        display: none;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 28px;
        font-size: 14px;
        font-weight: 600;
        color: var(--body);
      }
      .nav-links a {
        color: var(--body);
      }
      .nav-links a:hover {
        color: var(--ink);
      }
      .gh-link {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .gh-stars {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--muted);
      }
      .theme-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 999px;
        border: 1px solid var(--line-mid);
        background: transparent;
        color: var(--body);
        cursor: pointer;
        font-size: 14px;
      }
      .theme-toggle:hover {
        border-color: var(--line-strong);
      }

      /* hero */
      .hero {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 56px var(--gutter) 30px;
        display: grid;
        grid-template-columns: 1.05fr 1fr;
        gap: 60px;
        align-items: center;
      }
      .title {
        font-family: var(--font-head);
        font-weight: 700;
        font-size: 60px;
        line-height: 1;
        letter-spacing: -0.03em;
        margin: 0 0 22px;
        text-wrap: balance;
      }
      .lede {
        font-size: 19px;
        line-height: 1.58;
        color: var(--body);
        max-width: 36ch;
        margin: 0 0 34px;
        text-wrap: pretty;
      }
      .cta-row {
        display: flex;
        gap: 14px;
        align-items: center;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        font-weight: 700;
        font-size: 15px;
      }
      .btn-primary {
        padding: 14px 26px;
        background: var(--accent);
        color: var(--btn-text);
      }
      .btn-primary:hover {
        background: var(--accent-hover);
        color: var(--btn-text);
      }
      .btn-outline {
        padding: 13px 24px;
        border: 1.5px solid var(--line-strong);
        color: var(--ink);
      }
      .btn-outline:hover {
        color: var(--ink);
        border-color: var(--ink);
      }
      /* console */
      .console {
        margin: 0;
      }
      .glass {
        /* Thinner, muted frame so it frames the terminal without shouting:
           slimmer padding, a desaturated indigo wash, fainter grid + shadow. */
        padding: 6px;
        background:
          linear-gradient(155deg, #4c4e86, #2e3068),
          linear-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
        background-size:
          100% 100%,
          26px 26px,
          26px 26px;
        box-shadow:
          0 22px 46px -32px rgba(35, 37, 75, 0.4),
          inset 0 1px 2px rgba(255, 255, 255, 0.22);
      }
      .term {
        background: var(--term-bg);
        box-shadow: inset 0 2px 12px rgba(0, 0, 0, 0.55);
      }
      .term-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 11px 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }
      .dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #3a3330;
      }
      .term-title {
        margin-left: 8px;
        font-family: var(--font-mono);
        font-size: 11px;
        color: #8a8ca0;
      }
      .term-body {
        padding: 16px;
        height: 294px;
        /* Block scroll container so content keeps its natural height and
           overflows (a flex column would instead shrink the banner to fit).
           overflow:hidden means the user can't scroll or drag it — only the JS
           below moves it, pinning the view to the bottom after each command so
           the prompt stays put and the banner scrolls off. user-select:none
           stops drag-selection inside the console. */
        overflow: hidden;
        user-select: none;
        font-family: var(--font-mono);
        font-size: 12.5px;
        line-height: 1.65;
        color: var(--term-text);
      }
      .banner {
        margin: 0 0 10px;
        padding: 0;
        /* Otter body = default terminal foreground; gold runs opt in via .g. */
        color: var(--term-text);
        font-family: var(--font-mono);
        font-size: 6.5px;
        line-height: 1.28;
        white-space: pre;
        overflow: hidden;
      }
      .banner .g {
        color: var(--term-banner);
      }
      .line {
        display: flex;
        gap: 8px;
      }
      .line .prompt {
        color: var(--accent-2);
        flex: none;
      }
      .l {
        white-space: pre-wrap;
        word-break: break-word;
      }
      .l-cmd,
      .l-out {
        color: var(--term-text);
      }
      .l-ok {
        color: var(--out-ok);
      }
      .l-dim,
      .l-sys {
        color: var(--out-dim);
      }
      .l-err {
        color: var(--out-err);
      }
      .input-row {
        display: flex;
        gap: 8px;
        align-items: center;
        margin-top: 2px;
      }
      .input-row .prompt {
        color: var(--accent-2);
        flex: none;
      }
      .term-cursor {
        display: inline-block;
        width: 7px;
        height: 15px;
        background: var(--term-text);
        animation: term-blink 1.1s steps(1) infinite;
      }
      @keyframes term-blink {
        50% {
          opacity: 0;
        }
      }
      .term-hint {
        color: var(--out-dim);
      }
      .presets {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 14px;
      }
      .preset {
        text-align: left;
        background: var(--surf-soft);
        border: 1px solid var(--line-mid);
        padding: 6px 10px;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--body);
        cursor: pointer;
      }
      .preset:hover:not(:disabled) {
        border-color: var(--line-strong);
      }
      .preset:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
      .preset-reset {
        color: var(--accent);
      }

      /* trust band */
      .band {
        border-top: 1px solid var(--line-soft);
        border-bottom: 1px solid var(--line-soft);
        background: var(--surf-soft);
      }
      .band-inner {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 30px var(--gutter);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
      }
      .band-statement {
        margin: 0;
        font-family: var(--font-head);
        font-weight: 500;
        font-size: 24px;
        line-height: 1.3;
        color: var(--ink);
      }
      .tags {
        display: flex;
        gap: 12px;
      }
      .tag {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        color: var(--muted);
      }

      /* sections */
      .section {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 74px var(--gutter) 44px;
      }
      .section-head {
        display: flex;
        align-items: baseline;
        gap: 16px;
        margin-bottom: 38px;
      }
      .section-head h2 {
        font-family: var(--font-head);
        font-weight: 700;
        font-size: 34px;
        letter-spacing: -0.02em;
        margin: 0;
      }
      .kicker {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
      }

      /* feature cards */
      .features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }
      .card {
        /* Vertical stripes only — no grid crosslines, no gradient wash. */
        background-color: var(--surf-soft);
        background-image: linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
        background-size: 28px 100%;
        border: 1px solid var(--line-soft);
        padding: 24px 22px;
        min-height: 148px;
        box-shadow: 0 16px 34px -26px rgba(35, 37, 75, 0.4);
      }
      .card h3 {
        margin: 0 0 8px;
        font-size: 16px;
        font-weight: 700;
        letter-spacing: -0.01em;
      }
      .card p {
        margin: 0;
        font-size: 14px;
        line-height: 1.5;
        color: var(--body);
        text-wrap: pretty;
      }

      /* architecture */
      .arch {
        padding-top: 26px;
        padding-bottom: 74px;
      }
      .arch-kicker {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 28px;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .arch-panel {
        border: 1px solid var(--line-mid);
        background: var(--surf-soft);
        padding: 46px 32px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .node {
        border: 1px solid var(--line-strong);
        background: var(--surf-card);
        padding: 12px 26px;
        font-family: var(--font-mono);
        font-size: 13px;
      }
      .node-accent {
        border: 2px solid var(--accent);
        padding: 16px 42px;
        font-size: 15px;
        font-weight: 700;
        color: var(--accent);
        box-shadow: 0 14px 30px -18px rgba(93, 95, 239, 0.45);
      }
      .arch-label {
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 6px;
      }
      .connector {
        width: 1px;
        height: 22px;
        background: var(--line-strong);
      }
      .node-wide {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        min-width: 260px;
      }
      .node-title {
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 700;
        color: var(--ink);
      }
      .node-sub {
        font-size: 12px;
        color: var(--muted);
      }
      .arch-paths {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 44px;
        width: 100%;
        max-width: 760px;
        align-items: start;
      }
      .arch-col {
        display: flex;
        flex-direction: column;
      }
      .arch-col--write {
        align-items: flex-start;
      }
      .arch-col--read {
        align-items: flex-end;
      }
      .path-stack {
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .path-kicker {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .arch-col--read .path-kicker {
        text-align: right;
      }
      .arch-storage {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        width: 100%;
        max-width: 760px;
      }
      .node-shared {
        border-color: var(--line-strong);
        background: var(--surf-card);
      }

      /* quick start */
      .quickstart {
        border-top: 1px solid var(--line-soft);
        background: var(--surf-panel);
      }
      .quickstart-inner {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 74px var(--gutter);
      }
      .steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }
      .step {
        display: flex;
        flex-direction: column;
      }
      .step-head {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin-bottom: 12px;
      }
      .step-num {
        font-family: var(--font-head);
        font-weight: 700;
        font-size: 20px;
        color: var(--accent);
      }
      .step-label {
        font-size: 14px;
        font-weight: 700;
      }
      .code {
        margin: 0;
        flex: 1;
        background: var(--term-bg);
        color: var(--term-text);
        padding: 14px;
        border-radius: 10px;
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 1.6;
        white-space: pre-wrap;
        overflow-x: auto;
      }
      .quickstart-more {
        margin: 24px 0 0;
        font-size: 14px;
        color: var(--body);
      }

      /* CTA */
      .cta {
        border-top: 1px solid var(--line-soft);
      }
      .cta-inner {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 90px var(--gutter);
        text-align: center;
      }
      .cta-inner h2 {
        font-family: var(--font-head);
        font-weight: 700;
        font-size: 48px;
        letter-spacing: -0.03em;
        margin: 0 0 14px;
      }
      .cta-inner p {
        font-size: 18px;
        color: var(--body);
        margin: 0 auto 34px;
        max-width: 46ch;
        text-wrap: pretty;
      }
      .cta-center {
        justify-content: center;
      }

      /* footer */
      .footer {
        border-top: 1px solid var(--line-soft);
        background: var(--surf-foot);
      }
      .footer-inner {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: var(--gutter);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--muted);
      }
      .footer-links {
        display: flex;
        gap: 22px;
      }

      /* responsive */
      @media (max-width: 900px) {
        .hero {
          grid-template-columns: 1fr;
          gap: 40px;
        }
        .title {
          font-size: 44px;
        }
        .features,
        .steps {
          grid-template-columns: 1fr;
        }
        .arch-paths {
          grid-template-columns: 1fr;
          gap: 8px;
        }
      }
      @media (max-width: 560px) {
        .marginalia {
          font-size: 9px;
          gap: 8px;
        }
        .title {
          font-size: 36px;
        }
        .cta-inner h2 {
          font-size: 34px;
        }
      }
    </style>

    <script>
      // Theme toggle — writes Starlight's key so the preference carries into docs.
      const root = document.documentElement;
      const icon = document.querySelector('[data-theme-icon]');
      const syncIcon = () => {
        if (icon) icon.textContent = root.dataset.theme === 'dark' ? '☀' : '☾';
      };
      syncIcon();
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {
          /* ignore */
        }
        syncIcon();
        window.dispatchEvent(new Event('theme-change'));
      });

      // Live GitHub star count — degrades to plain "GitHub" if the API is unreachable.
      (async () => {
        const wrap = document.querySelector('.gh-stars');
        const count = document.querySelector('[data-gh-count]');
        if (!wrap || !count) return;
        try {
          const res = await fetch('https://api.github.com/repos/kakao/actionbase');
          if (!res.ok) return;
          const data = await res.json();
          if (typeof data.stargazers_count === 'number') {
            count.textContent = String(data.stargazers_count);
            wrap.hidden = false;
          }
        } catch {
          /* leave hidden */
        }
      })();

      // Console — a self-contained command parser over an in-memory edge set.
      const consoleEl = document.querySelector('[data-console]');
      if (consoleEl) {
        const linesEl = consoleEl.querySelector('[data-lines]');
        const bodyEl = consoleEl.querySelector('.term-body');
        // Keep the newest output (and the banner scrolling off the top) in view.
        const scrollToEnd = () => {
          if (bodyEl) bodyEl.scrollTop = bodyEl.scrollHeight;
        };
        const preset = [
          { source: 'Alice', target: 'Phone', ts: 5 },
          { source: 'Bob', target: 'Laptop', ts: 4 },
          { source: 'Bob', target: 'Phone', ts: 2 },
        ];
        let edges = preset.slice();

        const addLine = (kind, text, withPrompt) => {
          const row = document.createElement('div');
          row.className = 'line';
          if (withPrompt) {
            const p = document.createElement('span');
            p.className = 'prompt';
            p.textContent = 'actionbase>';
            row.appendChild(p);
          }
          const span = document.createElement('span');
          span.className = 'l l-' + kind;
          span.textContent = text;
          row.appendChild(span);
          linesEl.appendChild(row);
          scrollToEnd();
        };

        const parseFlags = (tokens) => {
          const f = {};
          for (let i = 1; i < tokens.length; i++) {
            const t = tokens[i];
            if (t.slice(0, 2) === '--') {
              const next = tokens[i + 1];
              f[t.slice(2)] = next && next.slice(0, 2) !== '--' ? next : true;
            }
          }
          return f;
        };

        const run = (raw) => {
          raw = (raw || '').trim();
          if (!raw) return;
          const tokens = raw.split(/\s+/);
          const cmd = tokens[0].toLowerCase();

          if (cmd === 'clear') {
            linesEl.replaceChildren();
            return;
          }

          addLine('cmd', raw, true);
          const f = parseFlags(tokens);

          if (cmd === 'get') {
            const hit = edges.find((e) => e.source === f.source && e.target === f.target);
            if (hit) {
              addLine('ok', '→ 1 edge');
              addLine('out', '  ' + hit.source + ' --likes--> ' + hit.target + '   (exists)');
            } else {
              addLine('dim', '→ 0 edges · not found');
            }
          } else if (cmd === 'count') {
            const dir = String(f.direction || 'OUT').toUpperCase();
            const m = edges.filter((e) => (dir === 'IN' ? e.target === f.start : e.source === f.start));
            addLine('ok', '→ ' + m.length);
          } else if (cmd === 'scan') {
            const dir = String(f.direction || 'OUT').toUpperCase();
            const m = edges
              .filter((e) => (dir === 'IN' ? e.target === f.start : e.source === f.start))
              .sort((a, b) => b.ts - a.ts);
            addLine('ok', '→ ' + m.length + ' edge' + (m.length === 1 ? '' : 's') + ' · index recent');
            m.forEach((e) => addLine('out', '  ' + e.source + ' --likes--> ' + e.target));
            if (!m.length) addLine('dim', '  (none)');
          } else if (cmd === 'load') {
            edges = preset.slice();
            addLine('ok', "→ preset 'likes' loaded · 3 edges");
          } else if (cmd === 'help') {
            addLine('dim', 'get   --source <n> --target <n>');
            addLine('dim', 'scan  --index recent --start <n> --direction OUT|IN');
            addLine('dim', 'count --start <n> --direction OUT|IN');
          } else {
            addLine('err', '? unknown command — try: get | scan | count | help');
          }
        };

        // Guided tour: the three presets unlock one at a time, in order; a reset
        // appears once the tour has started and returns the console to step one.
        const stepButtons = [...consoleEl.parentElement.querySelectorAll('[data-step]')];
        const resetButton = consoleEl.parentElement.querySelector('[data-reset]');
        const initialLines = [
          ['sys', 'actionbase standalone · server :8080 · CLI ready'],
          ['sys', "preset 'likes' loaded — 3 edges"],
          ['sys', 'Alice → Phone    Bob → Laptop    Bob → Phone'],
          ['dim', 'run the steps below, in order ↓'],
        ];
        let step = 0;

        const syncButtons = () => {
          stepButtons.forEach((b, i) => {
            b.disabled = i !== step;
          });
          if (resetButton) resetButton.hidden = step === 0;
        };

        stepButtons.forEach((btn, i) => {
          btn.addEventListener('click', () => {
            if (i !== step) return;
            run(btn.getAttribute('data-cmd'));
            step = Math.min(step + 1, stepButtons.length);
            syncButtons();
          });
        });

        resetButton?.addEventListener('click', () => {
          edges = preset.slice();
          linesEl.replaceChildren();
          initialLines.forEach(([k, t]) => addLine(k, t, false));
          step = 0;
          syncButtons();
        });

        syncButtons();
        // Pin to the bottom now, on the next frame, and again once the tiny
        // 6.5px banner webfont swaps in (which changes the scroll height).
        scrollToEnd();
        requestAnimationFrame(scrollToEnd);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(scrollToEnd);
      }
    </script>
  </body>
</html>
