---
import logoLight from '../assets/logo-light.svg?url';
import logoDark from '../assets/logo-dark.svg?url';
import { Check, Copy, Moon, Sun } from '@lucide/astro';
import HeroArt from '../components/landing/HeroArt.astro';
import DemoSection from '../components/landing/DemoSection.astro';
import ArchDiagram from '../components/landing/ArchDiagram.astro';
import '../assets/landing-page.css';

// Standalone marketing landing. Kept outside Starlight's content collection so
// the bespoke chrome (marginalia, hero console, architecture flow) has full
// layout control; theme state still syncs with Starlight via the shared
// `starlight-theme` localStorage key and `<html data-theme>` attribute.

const GA_ID = 'G-2PY5JXRJ5J';
const site = 'https://actionbase.io/';
const pageTitle = 'Actionbase — A database for user interactions at scale';
const description =
  'Actionbase serves follows, likes, and views as precomputed lookups — one model for ' +
  'user–user, user–item, and item–item interactions, in production at Kakao at over a ' +
  'million requests per minute.';
const ogUrl = new URL('og.png?v=1', site).href;
const ogImageAlt =
  'Actionbase is a production-proven OLTP database serving tens of millions of users across Kakao.';
const repo = 'https://github.com/kakao/actionbase';

const primaryFeatures = [
  { title: 'Pre-computed Reads', desc: 'Writes do the work. Reads return what’s already computed.' },
  { title: 'U2U · U2I · I2I', desc: 'One model for user–user, user–item, and item–item interactions.' },
  { title: 'Battle-tested', desc: 'Over a million requests per minute in stable production at Kakao.' },
];

const platformFeatures = [
  { title: 'REST API', desc: 'Simple writes, fast reads — all via HTTP.' },
  { title: 'CDC Built-in', desc: 'Stream changes for downstream pipelines.' },
  { title: 'Pluggable Storage', desc: 'A minimal storage abstraction — HBase today, SlateDB planned.' },
];

const steps = [
  { n: '1', label: 'Run', code: 'docker run -it \\\n  ghcr.io/kakao/actionbase:standalone' },
  { n: '2', label: 'Load sample data', code: 'load preset likes' },
  {
    n: '3',
    label: 'Query — just read',
    code: 'get   --source Alice --target Phone\nscan  --index recent --start Bob --direction OUT\ncount --start Phone --direction IN',
  },
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" class="js-site-favicon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Actionbase" />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,500;0,600;0,700;1,600&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Apply persisted theme before paint to avoid a flash; shares Starlight's key. -->
    <script is:inline>
      (function () {
        const stored = typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <script is:inline>
      (function () {
        const updateFavicon = () => {
          const isDark = document.documentElement.dataset.theme === 'dark';
          const favicon = document.querySelector('.js-site-favicon');
          if (favicon) favicon.href = isDark ? '/favicon-dark.svg' : '/favicon.svg';
        };
        updateFavicon();
        window.addEventListener('theme-change', updateFavicon);
      })();
    </script>

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>
  </head>

  <body>
    <div class="page">
      <a class="skip-link" href="#main">Skip to content</a>
      <!-- nav -->
      <nav class="nav">
        <a class="brand" href="/">
          <img class="brand-logo brand-logo-light" src={logoLight} alt="Actionbase" width="170" height="26" />
          <img class="brand-logo brand-logo-dark" src={logoDark} alt="Actionbase" width="170" height="26" />
        </a>
        <div class="nav-links">
          <a class="nav-text-link" href="/introduction/">Docs</a>
          <a class="nav-text-link nav-stories" href="/stories/">Stories</a>
          <a href={repo} class="gh-link" aria-label="GitHub">
            <span class="gh-count" data-star-count hidden></span>
            <svg class="gh-icon" viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
            </svg>
          </a>
          <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle color theme">
            <Moon class="theme-icon-moon" size={16} aria-hidden="true" />
            <Sun class="theme-icon-sun" size={16} aria-hidden="true" />
          </button>
        </div>
      </nav>

      <main id="main">
      <!-- hero -->
      <header class="hero">
        <div class="hero-copy">
          <h1 class="title">
            Precomputed at write time, served as <span class="accent">simple lookups</span>
          </h1>
          <p class="lede">
            One database for user–user (follows), user–item (likes), and item–item (related
            items) interactions.
          </p>
          <div class="cta-row">
            <a class="btn btn-primary" href="/quick-start/">Quick Start</a>
            <a class="btn btn-outline" href="/introduction/">Explore docs</a>
          </div>
        </div>

        <HeroArt />
      </header>

      <!-- trust band -->
      <section class="band">
        <div class="band-inner">
          <p class="band-statement">
            Serving over <span class="accent">a million requests per minute</span>, in production at Kakao.
          </p>
          <div class="band-facts">
            <span class="fact">Apache-2.0</span>
            <span class="fact">REST · CDC</span>
            <span class="fact">HBase / SlateDB</span>
          </div>
        </div>
      </section>

      <!-- try it: live console + edge graph -->
      <DemoSection />

      <!-- features -->
      <section class="section feature-section">
        <div class="section-head">
          <h2>Why Actionbase</h2>
          <span class="kicker">Built for interaction data</span>
        </div>
        <div class="feature-group">
          <span class="feature-group-label">Core advantages</span>
          <div class="features features-primary">
            {
              primaryFeatures.map((f, i) => (
                <article class="card card-primary">
                  <span class="card-num">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{f.title}</h3>
                  <p>{f.desc}</p>
                </article>
              ))
            }
          </div>
        </div>
        <div class="feature-group">
          <span class="feature-group-label">Platform capabilities</span>
          <div class="features features-secondary">
            {
              platformFeatures.map((f, i) => (
                <article class="card card-secondary">
                  <span class="card-num">{String(i + 4).padStart(2, '0')}</span>
                  <h3>{f.title}</h3>
                  <p>{f.desc}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- architecture -->
      <section class="section arch">
        <div class="section-head">
          <h2>Architecture</h2>
          <span class="kicker">Client → Actionbase → storage &amp; stream</span>
        </div>
        <ArchDiagram />
      </section>

      <!-- quick start -->
      <section class="quickstart">
        <div class="quickstart-inner">
          <div class="section-head">
            <h2>Quick start</h2>
            <span class="kicker">Three steps</span>
          </div>
          <div class="steps">
            {
              steps.map((s) => (
                <div class="step">
                  <div class="step-head">
                    <span class="step-num">{s.n}</span>
                    <span class="step-label">{s.label}</span>
                    <button
                      type="button"
                      class="copy-code"
                      data-copy-code={s.code}
                      aria-label={`Copy ${s.label} command`}
                      title={`Copy ${s.label} command`}
                    >
                      <Copy class="copy-icon" size={16} aria-hidden="true" />
                      <Check class="check-icon" size={16} aria-hidden="true" />
                    </button>
                  </div>
                  <div class="code-wrap">
                    <pre class="code">{s.code}</pre>
                  </div>
                </div>
              ))
            }
          </div>
          <p class="quickstart-more">
            See the <a href="/quick-start/">Quick Start</a>, or
            <a href="/guides/build-your-social-media-app/">Build Your Social Media App</a> to go deeper.
          </p>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta">
        <div class="cta-inner">
          <h2>Start building</h2>
          <p>
            The reference covers concepts, architecture, and hands-on guides — from a single write to a
            million reads per minute.
          </p>
          <div class="cta-row cta-center">
            <a class="btn btn-primary" href="/quick-start/">Quick Start</a>
            <a class="btn btn-outline" href="/introduction/">Explore docs</a>
          </div>
        </div>
      </section>
      </main>

      <!-- footer -->
      <footer class="footer">
        <div class="footer-inner">
          <span>© 2026 Kakao Corp. · Apache-2.0</span>
          <div class="footer-links">
            <a href="/introduction/">Docs</a>
            <a href="/stories/">Stories</a>
            <a href={repo} aria-label="GitHub">
              <svg class="gh-icon" viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
              </svg>
            </a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      // Theme toggle — writes Starlight's key so the preference carries into
      // docs. The moon/sun icons swap via CSS on html[data-theme].
      const root = document.documentElement;
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {
          /* ignore */
        }
        window.dispatchEvent(new Event('theme-change'));
      });

      // Live GitHub star count in the nav pill; fails silently (rate limits,
      // offline) leaving the plain icon button.
      fetch('https://api.github.com/repos/kakao/actionbase')
        .then((r) => (r.ok ? r.json() : null))
        .then((repo) => {
          const count = repo?.stargazers_count;
          const el = document.querySelector('[data-star-count]');
          if (typeof count !== 'number' || !(el instanceof HTMLElement)) return;
          el.textContent = count >= 1000 ? `★ ${(count / 1000).toFixed(1).replace(/\.0$/, '')}k` : `★ ${count}`;
          el.hidden = false;
          el.closest('.gh-link')?.classList.add('has-count');
        })
        .catch(() => {});

      // Console — a self-contained command parser over an in-memory edge set.
      const consoleEl = document.querySelector('[data-console]');
      if (consoleEl) {
        const linesEl = consoleEl.querySelector('[data-lines]');
        const initialLinesHTML = linesEl.innerHTML;
        const bodyEl = consoleEl.querySelector('.term-body');
        // Keep the newest output (and the banner scrolling off the top) in view.
        const scrollToEnd = () => {
          if (bodyEl) bodyEl.scrollTop = bodyEl.scrollHeight;
        };
        // Edge-state graph — the console drives it so a command's meaning is
        // visible: get highlights one edge, scan/count highlight a fan of them.
        const graphEl = document.querySelector('[data-graph]');
        const gEdges = graphEl ? [...graphEl.querySelectorAll('.gedge')] : [];
        const gNodes = graphEl ? [...graphEl.querySelectorAll('.gnode')] : [];

        // every edge label reads "likes" until count numbers the matched ones 1, 2, …
        const resetLabels = () => {
          gEdges.forEach((e) => {
            const t = e.querySelector('.gedge-label');
            if (t) {
              t.textContent = 'likes';
              t.classList.remove('num');
            }
          });
        };
        const focusGraph = (edgeIds, nodeIds) => {
          const es = new Set(edgeIds);
          const ns = new Set(nodeIds);
          gEdges.forEach((e) => {
            const on = es.has(e.dataset.edge);
            e.classList.toggle('on', on);
            e.classList.toggle('dim', !on);
          });
          gNodes.forEach((n) => {
            const on = ns.has(n.dataset.node);
            n.classList.toggle('on', on);
            n.classList.toggle('dim', !on);
          });
          resetLabels();
        };
        // count: label the matched edges 1, 2, … so the total reads off the graph
        const numberEdges = (edgeIds) => {
          edgeIds.forEach((id, i) => {
            const el = gEdges.find((e) => e.dataset.edge === id);
            const t = el && el.querySelector('.gedge-label');
            if (t) {
              t.textContent = String(i + 1);
              t.classList.add('num');
            }
          });
        };

        const addLine = (kind, text, withPrompt) => {
          const row = document.createElement('div');
          row.className = 'line';
          if (withPrompt) {
            const p = document.createElement('span');
            p.className = 'prompt';
            p.textContent = 'actionbase(likes:likes)>';
            row.appendChild(p);
          }
          const span = document.createElement('span');
          span.className = 'l l-' + kind;
          span.textContent = text;
          row.appendChild(span);
          linesEl.appendChild(row);
          scrollToEnd();
        };

        // Output mirrors the real CLI for the three preset commands (fixed
        // dataset), down to the request line, result table and timing.
        const OUT = {
          get: [
            '  │ → GET /graph/v3/databases/likes/tables/likes/edges/get?source=Alice&target=Phone',
            '  │ ← 200 OK {"edges":[{"version":1784793660730,"source":"Alice","targ...',
            '  │',
            '  │ The edge is found: [Alice -> Phone]',
            '  │ |---------------|--------|--------|---------------------------|',
            '  │ | VERSION       | SOURCE | TARGET | PROPERTIES                |',
            '  │ |---------------|--------|--------|---------------------------|',
            '  │ | 1784793660730 | Alice  | Phone  | created_at: 1784793660730 |',
            '  │ |---------------|--------|--------|---------------------------|',
            '  │ (Took 0.0824 seconds)',
            '  │',
          ],
          scan: [
            '  │ → GET /graph/v3/databases/likes/tables/likes/edges/scan/recent?direction=OUT&limit=25&start=Bob',
            '  │ ← 200 OK {"edges":[{"version":1784793660730,"source":"Bob","target...',
            '  │ The 2 edges found (offset: -, hasNext: false)',
            '  │ |---|---------------|--------|--------|---------------------------|',
            '  │ | # | VERSION       | SOURCE | TARGET | PROPERTIES                |',
            '  │ |---|---------------|--------|--------|---------------------------|',
            '  │ | 1 | 1784793660730 | Bob    | Laptop | created_at: 1784793660730 |',
            '  │ | 2 | 1784793660730 | Bob    | Phone  | created_at: 1784793660730 |',
            '  │ |---|---------------|--------|--------|---------------------------|',
            '  │ (Took 0.0531 seconds)',
            '  │',
          ],
          count: [
            '  │ → GET /graph/v3/databases/likes/tables/likes/edges/counts?start=Phone&direction=IN',
            '  │ ← 200 OK {"counts":[{"start":"Phone","direction":"IN","count":2,"c...',
            '  │',
            '  │ The count of 1 edges found',
            '  │ |---|-------|-----------|-------|',
            '  │ | # | START | DIRECTION | COUNT |',
            '  │ |---|-------|-----------|-------|',
            '  │ | 1 | Phone | IN        | 2     |',
            '  │ |---|-------|-----------|-------|',
            '  │ (Took 0.0477 seconds)',
            '  │',
          ],
        };

        const run = (raw) => {
          const cmd = (raw || '').trim().split(/\s+/)[0].toLowerCase();
          if (!OUT[cmd]) return;
          addLine('cmd', raw, true);
          OUT[cmd].forEach((t) => addLine('dim', t));
          if (cmd === 'get') {
            focusGraph(['alice-phone'], ['alice', 'phone']);
          } else if (cmd === 'scan') {
            focusGraph(['bob-phone', 'bob-laptop'], ['bob', 'phone', 'laptop']);
          } else if (cmd === 'count') {
            focusGraph(['alice-phone', 'bob-phone'], ['alice', 'bob', 'phone']);
            numberEdges(['alice-phone', 'bob-phone']);
          }
        };

        // Any step runs on click — no forced order. The clicked button takes an
        // active state; TBD teasers stay disabled via markup.
        const stepButtons = [...document.querySelectorAll('[data-step]')];
        stepButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            stepButtons.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            run(btn.getAttribute('data-cmd'));
          });
        });

        // Reset: restore the opening console output and clear the graph state.
        const resetButton = document.querySelector('[data-reset]');
        resetButton?.addEventListener('click', () => {
          linesEl.innerHTML = initialLinesHTML;
          gEdges.forEach((e) => e.classList.remove('on', 'dim'));
          gNodes.forEach((n) => n.classList.remove('on', 'dim'));
          resetLabels();
          stepButtons.forEach((b) => b.classList.remove('active'));
          scrollToEnd();
        });
        // Pin to the bottom now, on the next frame, and again once the tiny
        // 6.5px banner webfont swaps in (which changes the scroll height).
        scrollToEnd();
        requestAnimationFrame(scrollToEnd);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(scrollToEnd);
      }

      // Try-it tabs: switch between the supported and coming-soon panels.
      const tabList = document.querySelector('[data-tabs]');
      if (tabList) {
        const tabs = [...tabList.querySelectorAll('.tab')];
        const panels = [...document.querySelectorAll('.tab-panel')];
        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const name = tab.dataset.tab;
            tabs.forEach((t) => {
              const on = t === tab;
              t.classList.toggle('active', on);
              t.setAttribute('aria-pressed', String(on));
            });
            panels.forEach((p) => {
              p.hidden = p.dataset.panel !== name;
            });
          });
        });
      }

      document.querySelectorAll('[data-copy-code]').forEach((button) => {
        const idleLabel = button.getAttribute('aria-label') || 'Copy command';
        button.addEventListener('click', async () => {
          const code = button.getAttribute('data-copy-code') || '';
          try {
            await navigator.clipboard.writeText(code);
            button.classList.add('copied');
            button.setAttribute('aria-label', 'Copied');
            window.setTimeout(() => {
              button.classList.remove('copied');
              button.setAttribute('aria-label', idleLabel);
            }, 1600);
          } catch {
            button.setAttribute('aria-label', 'Copy failed');
          }
        });
      });
    </script>
  </body>
</html>
