---
import config from 'virtual:starlight/user-config';

const links = config.social || [];
const githubLink = links.find((l) => l.icon === 'github');
---

{
  githubLink && (
    <a href={githubLink.href} rel="me" class="sl-flex github-stars">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z" />
      </svg>
      <span class="star-count" id="gh-star-count" aria-label="GitHub stars"></span>
    </a>
  )
}

<script>
  const REPO = 'kakao/actionbase';
  const CACHE_KEY = 'gh-stars';
  const CACHE_TTL = 3600_000; // 1 hour

  function formatCount(n: number): string {
    if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
    return String(n);
  }

  async function updateStars() {
    const el = document.getElementById('gh-star-count');
    if (!el) return;

    // Check cache
    try {
      const cached = JSON.parse(localStorage.getItem(CACHE_KEY) || '{}');
      if (cached.count != null && Date.now() - cached.ts < CACHE_TTL) {
        el.textContent = formatCount(cached.count);
        return;
      }
    } catch {
      // ignore
    }

    // Fetch from GitHub API
    try {
      const res = await fetch(`https://api.github.com/repos/${REPO}`, {
        headers: { Accept: 'application/vnd.github.v3+json' },
      });
      if (!res.ok) return;
      const data = await res.json();
      const count = data.stargazers_count;
      el.textContent = formatCount(count);
      localStorage.setItem(CACHE_KEY, JSON.stringify({ count, ts: Date.now() }));
    } catch {
      // silent fail — icon still shows without count
    }
  }

  updateStars();
  document.addEventListener('astro:after-swap', updateStars);
</script>

<style>
  a {
    color: var(--sl-color-text-accent);
    padding: 0.5em;
    margin: -0.5em;
  }
  a:hover {
    opacity: 0.66;
  }
  svg {
    width: 1em;
    height: 1em;
  }
  .github-stars {
    align-items: center;
    gap: 0.35em;
    text-decoration: none;
  }
  .star-count {
    font-size: var(--sl-text-xs);
    line-height: 1;
    color: var(--sl-color-text-accent);
  }
  .star-count:empty {
    display: none;
  }
</style>
