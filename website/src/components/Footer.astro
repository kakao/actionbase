---
// Keeps Starlight's footer (pagination, last-updated, edit link) and appends a
// mono footer bar matching the landing, for a consistent close on every page.
import StarlightFooter from '@astrojs/starlight/components/Footer.astro';
---

<StarlightFooter />

<div class="ab-footer">
  <span>© 2026 Kakao Corp. · Apache-2.0</span>
  <a href="https://github.com/kakao/actionbase" target="_blank" rel="noopener">GitHub</a>
</div>

<style>
  .ab-footer {
    /* Keep the left edge at the content (never cover the nav menu) but extend
       rightward under the on-this-page rail, so the bar spans content + right
       sidebar as one band. */
    margin-right: calc(50% - 50vw);
    box-sizing: border-box;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
    padding: 1.25rem 0;
    padding-right: clamp(1.5rem, 4vw, 4rem);
    border-top: 1px solid var(--sl-color-hairline);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }
  .ab-footer a {
    color: var(--sl-color-gray-3);
  }
  .ab-footer a:hover {
    color: var(--sl-color-text-accent);
  }
</style>
