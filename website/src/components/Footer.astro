---
import Default from '@astrojs/starlight/components/Footer.astro';

const { locale, slug } = Astro.locals.starlightRoute;
const isKorean = locale === 'ko';
const isBlog = slug.startsWith('blog/');
const showTranslationNotice = isKorean && !isBlog;
---

<Default {...Astro.props}><slot /></Default>

{showTranslationNotice && (
  <p class="translation-notice">(이 문서는 <a href="https://huggingface.co/collections/kakaocorp/kanana-2" target="_blank" rel="noopener">Kanana-2</a>로 번역되었습니다.)</p>
)}

<style>
  .translation-notice {
    margin-top: 1.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .translation-notice a {
    color: var(--sl-color-gray-3);
    text-decoration: underline;
  }
  .translation-notice a:hover {
    color: var(--sl-color-white);
  }
</style>
