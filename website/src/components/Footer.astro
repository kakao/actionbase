---
// Keeps Starlight's footer (pagination, last-updated, edit link) and appends a
// mono footer bar matching the landing, for a consistent close on every page.
import StarlightFooter from '@astrojs/starlight/components/Footer.astro';
---

<StarlightFooter />

<div class="ab-footer">
  <span>© 2026 Kakao Corp. · Apache-2.0</span>
  <a href="https://github.com/kakao/actionbase" target="_blank" rel="noopener">GitHub</a>
</div>

<style>
  .ab-footer {
    /* Span from the nav-menu divider (left) to the viewport edge (right) so the
       bar's top rule meets the vertical divider with no gap, and never covers
       the menu itself. (+scrollbar correction so the left edge lands on the
       divider.) */
    margin-left: calc(50% - 50vw + var(--sl-sidebar-width) + 31px);
    margin-right: calc(50% - 50vw);
    box-sizing: border-box;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
    padding: 1.25rem clamp(1.5rem, 4vw, 4rem);
    border-top: 1px solid var(--sl-color-hairline);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }
  .ab-footer a {
    color: var(--sl-color-gray-3);
  }
  .ab-footer a:hover {
    color: var(--sl-color-text-accent);
  }
  @media (max-width: 50rem) {
    .ab-footer {
      width: 100%;
      margin-left: 0;
      margin-right: 0;
      padding: 1.25rem 0;
    }
  }
</style>
