{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["OPENCODE.md"],
  "provider": {
    "kap": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "KAP (On-Premise)",
      "options": {
        "baseURL": "https://api-inference-internal.kap.9rum.cc/v1"
      },
      "models": {
